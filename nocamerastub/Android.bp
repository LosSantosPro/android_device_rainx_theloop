// Stub app that suppresses Camera2 via Soong overrides.
// Must be outside device/rainx/theloop/ to avoid its soong_namespace
// which prevents android_app modules from being exported to Make.
android_app {
    name: "NoCameraStub",
    overrides: ["Camera2", "DeviceAsWebcam", "CameraExtensions"],
    srcs: ["src/com/android/nocamerastub/Stub.java"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
}

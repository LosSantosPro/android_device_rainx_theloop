  <remote name="angry-im" fetch="https://gitea.angry.im/PeterCxy/" revision="master" />

  <!-- Device and vendor trees -->
  <project name="android_device_rainx_theloop" path="device/rainx/theloop" remote="rainx" />
  <project name="android_vendor_rainx_theloop" path="vendor/rainx/theloop" remote="rainx" />

  <!-- OpenEUICC (FOSS eSIM manager for dual soldered eUICCs) -->

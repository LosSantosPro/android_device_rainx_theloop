  <project name="android_prebuilts_openeuicc-deps" path="prebuilts/openeuicc-deps" remote="angry-im" clone-depth="1" />

  <!-- MicroG (signature spoofing native on LOS23 userdebug) -->
  <project name="lineageos4microg/android_vendor_partner_gms" path="vendor/partner_gms" remote="github" revision="master" clone-depth="1" />

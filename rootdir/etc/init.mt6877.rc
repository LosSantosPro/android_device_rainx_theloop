# MTK platform .rc configure - theloop device

import /vendor/etc/init/hw/init.project.rc
import /vendor/etc/init/hw/init.connectivity.rc
import /vendor/etc/init/hw/init.mt6877.usb.rc
import /vendor/etc/init/hw/init.sensor_2_0.rc

# init.modem.rc must be LAST - vold.post_fs_data_done is set in it
import /vendor/etc/init/hw/init.modem.rc

# Bootloader injects console=ttyS0,921600n1 into cmdline.
# If ro.debuggable=1 (userdebug build), system init.rc starts console.
# Stop it on boot_completed to suppress the SystemUI notification.
on property:sys.boot_completed=1
    stop console

on early-init
    write /proc/bootprof "INIT:early-init"
    mkdir /mnt/vendor/persist 0771 root root
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist noatime nosuid nodev

on init
    write /proc/bootprof "INIT:init"
    write /proc/sys/vm/swappiness 100
    symlink /dev/block/platform/soc/11230000.mmc /dev/block/platform/bootdevice

on fs
    write /proc/bootprof "INIT:fs"
    start vendor.boot-default
    wait /dev/block/platform/soc/11230000.mmc
    mount_all --early

on late-fs
    # mount_all --late restored (latemount removed from fstab)
    mount_all --late
    exec -- /vendor/bin/load_gpu_modules.sh

on post-fs
    write /proc/bootprof "INIT:post-fs"
    # Setup USB configfs before gadget HAL starts
    mkdir /config/usb_gadget/g1 0770 shell shell
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /config/usb_gadget/g1/functions/ffs.ptp
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000,no_disconnect=1
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mount functionfs mtp /dev/usb-ffs/mtp uid=1024,gid=1024,no_disconnect=1
    mkdir /dev/usb-ffs/ptp 0770 mtp mtp
    mount functionfs ptp /dev/usb-ffs/ptp uid=1024,gid=1024,no_disconnect=1
    setprop sys.usb.configfs 1
    setprop sys.usb.controller 11201000.usb0
    chown system system /mnt/vendor/protect_f
    chmod 0770 /mnt/vendor/protect_f
    chown system system /mnt/vendor/protect_s
    chmod 0770 /mnt/vendor/protect_s
    chown root log /proc/ccci_sib
    chown root system /proc/ccci_dump

on post-fs-data
    write /proc/bootprof "INIT:post-fs-data"

    # Camera device nodes. These are created by the imgsensor /
    # camera_isp / ccu_isp6s / camera_{dip,dpe,fdvt,mem,mfb,rsc,wpe}
    # kernel modules (all listed in modules.load). The drivers create
    # the nodes with mode 0600 root:root which blocks camerahalserver
    # (runs as system:camera). MTK stock init.mt6877.rc fixes this up
    # post-fs-data; we need the same fix here or the camera HAL reports
    # "pSeninfDrv->init() fail" → 0 devices → the camera app self-kills.
    #
    # /dev/ccu is also critical: MTK's CCU (Camera Control Unit) is a
    # dedicated microcontroller inside the ISP that runs the fast
    # AE/AF/AWB loops. lib3a.ccuif.so opens /dev/ccu during camera HAL
    # init to IOCTL the kernel driver into loading /vendor/firmware/
    # lib3a.ccu as the CCU's DDR-resident firmware. Without the chmod/
    # chown here it's root:root 0600 → camerahalserver gets EACCES →
    # _ccuInitProc reports "load ddr binary file in kernel fail" →
    # SIGSEGV in the GyroMVCalculato thread → camerahalserver crashes.
    # Appears as "camera_num is 0, mostly camerahalserver happened some
    # error" in CamAp_CameraApiHelper. Stock ships system:camera 0660.
    chmod 0660 /dev/camera-isp
    chmod 0660 /dev/camera-mem
    chmod 0660 /dev/camera-dip
    chmod 0660 /dev/camera-dpe
    chmod 0660 /dev/camera-mfb
    chmod 0660 /dev/camera-rsc
    chmod 0660 /dev/camera-fdvt
    chmod 0660 /dev/camera-wpe
    chmod 0660 /dev/ccu
    chmod 0660 /dev/kd_camera_hw
    chmod 0660 /dev/seninf
    chmod 0660 /dev/flashlight
    chmod 0660 /dev/MAINAF
    chmod 0660 /dev/MAIN2AF
    chmod 0660 /dev/MAIN3AF
    chmod 0660 /dev/SUBAF
    chown system camera /dev/camera-isp
    chown system camera /dev/camera-mem
    chown system camera /dev/camera-dip
    chown system camera /dev/camera-dpe
    chown system camera /dev/camera-mfb
    chown system camera /dev/camera-rsc
    chown system camera /dev/camera-fdvt
    chown system camera /dev/camera-wpe
    chown system camera /dev/ccu
    chown system camera /dev/kd_camera_hw
    chown system camera /dev/seninf
    chown system camera /dev/flashlight
    chown system camera /dev/MAINAF
    chown system camera /dev/MAIN2AF
    chown system camera /dev/MAIN3AF
    chown system camera /dev/SUBAF

on property:vendor.all.modules.ready=1
    # Touch driver deps not in modules.load; load manually
    exec -- /system/bin/insmod /vendor/lib/modules/csci_driver.ko
    exec -- /system/bin/insmod /vendor/lib/modules/middle_misc.ko
    exec -- /system/bin/insmod /vendor/lib/modules/hwinfo.ko

on boot
    write /proc/bootprof "INIT:boot"
    setprop sys.usb.controller 11201000.usb0
    setprop vendor.usb.controller 11201000.usb0
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb

# genfs_contexts for theloop (mt6877).
# Extracted from proprietary vendor_sepolicy.cil genfscon entries.
# Types not in mtk_types.te are declared in genfs_types.te.

# GED (Graphics Extension Driver) - GPU perf/DVFS bridge used by SF,
# bootanim, composer, and app RenderThreads.
genfscon proc /ged                          u:object_r:proc_ged:s0

# Boot profiling node; vendor_init writes stage markers here.
genfscon proc /bootprof                     u:object_r:proc_bootprof:s0

# Bluetooth driver debug knob; exposed at both paths depending on build.
genfscon proc /bt_dbg                       u:object_r:proc_btdbg:s0
genfscon proc /driver/bt_dbg                u:object_r:proc_btdbg:s0

# Performance manager nodes
genfscon proc /perfmgr                                     u:object_r:proc_perfmgr:s0
# perfserv_freq read-out node; type declared in genfs_types.te.
genfscon proc /powerhal_cpu_ctrl/perfserv_freq             u:object_r:proc_perfserv:s0

# Modem info node used by thermal HAL for temperature/RSSI readings.
genfscon proc /driver/thermal/mdm_mdinfo                   u:object_r:proc_mdm_mdinfo:s0

# Per-pid RSS tracking node used by lmkd-feeder and vendor processes.
genfscon proc /dma_heap/rss_pid                            u:object_r:proc_rss_pid:s0

# CCCI dump/SIB proc nodes (modem diag).
genfscon proc /ccci_dump                    u:object_r:proc_ccci_dump:s0
genfscon proc /ccci_sib                     u:object_r:proc_ccci_sib:s0

# Power-supply / battery sysfs - read by hal_health_default. Without
# the label, health HAL falls back to sysfs:s0 and reports unknown
# battery status. Both the symlink dir and physical device paths must
# be labelled since genfscon applies to inodes, not symlinks.
genfscon sysfs /class/power_supply                                                              u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/battery-manager/power_supply                                   u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/10026000.pwrap/10026000.pwrap:mt6359p/mt6359p-gauge/power_supply   u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/charger/power_supply                                           u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/11d00000.i2c5/i2c-5/5-0034/mt6360-chg.2.auto/power_supply      u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/11d03000.i2c9/i2c-9/9-0055/power_supply                        u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/11d21000.i2c2/i2c-2/2-006a/power_supply                        u:object_r:sysfs_batteryinfo:s0

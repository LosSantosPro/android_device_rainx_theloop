# Netlink kobject uevent sockets for MTK vendor HALs.
# AOSP base policy does not grant uevent socket access to these domains
# because the reference HALs do not read kernel uevents; the MTK HALs do.

allow hal_thermal_default self:netlink_kobject_uevent_socket {
    create bind getattr read write setopt getopt
};

allow hal_graphics_composer_default self:netlink_kobject_uevent_socket {
    create bind getattr read write setopt getopt
};

# init - early modprobe/insmod path before ueventd takes over.
allow init self:netlink_kobject_uevent_socket {
    create bind getattr read write setopt getopt
};

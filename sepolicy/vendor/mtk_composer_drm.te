# DRM and gralloc access for the MTK composer HAL.
#
# AOSP base policy grants gpu_device access (for /dev/mali0) but the MTK
# HWC opens /dev/dri/card0 (dri_device), requiring separate grants. The
# full 0x64xx DRM_COMMAND_BASE ioctl range is allowed to cover all KMS
# ioctls used by the MTK DRM driver.
#
# The composer also needs to mmap gralloc-allocated tmpfs buffers received
# via binder fd-passing from surfaceflinger. Direct IAllocator contact
# (service_manager find, binder call) is intentionally NOT granted due to
# AOSP neverallows - only the tmpfs mmap is allowed.

# /dev/dri/card0 base access; ioctl gated by xperm below.
allow hal_graphics_composer_default dri_device:chr_file {
    open read write ioctl map getattr lock append
};

# DRM_IOCTL xperm: full 0x6400-0x64ff (DRM_COMMAND_BASE..END).
allowxperm hal_graphics_composer_default dri_device:chr_file ioctl {
    0x6400-0x64ff
};

# Gralloc tmpfs buffer mmap - composer receives fds via SF binder,
# not via direct IAllocator contact (which is neverallowed).
allow hal_graphics_composer_default hal_graphics_allocator_default_tmpfs:file {
    read write getattr map
};

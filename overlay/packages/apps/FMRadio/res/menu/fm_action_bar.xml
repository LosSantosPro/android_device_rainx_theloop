<!--
     theloop overlay: hide the headphone / earphone / speaker route
     selector. theloop is a smart speaker with no 3.5 mm jack and the
     audio always plays out the integrated speaker via the primary
     output. The fm_headset entry is kept so FmMainActivity.java
     R.id.fm_headset references still resolve at runtime; just hidden.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/fm_station_list"
          android:showAsAction="always"
          android:title="@string/station_title"
          android:icon="@drawable/btn_fm_list_selector"
          android:enabled="true"/>
    <item android:id="@+id/fm_headset"
          android:showAsAction="never"
          android:visible="false"
          android:icon="@drawable/btn_fm_headset_selector"
          android:enabled="false">
          <menu>
              <item android:id="@+id/earphone_menu"
                    android:title="@string/optmenu_earphone"
                    android:visible="false"
                    android:enabled="false"/>
              <item android:id="@+id/speaker_menu"
                    android:title="@string/optmenu_speaker"
                    android:visible="false"
                    android:enabled="false"/>
          </menu>
    </item>
    <item
        android:id="@+id/fm_start_record"
        android:showAsAction="never"
        android:title="@string/fm_over_start_record" />
    <item
        android:id="@+id/fm_record_list"
        android:showAsAction="never"
        android:title="@string/fm_over_record_list" />
</menu>
